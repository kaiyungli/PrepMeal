  {
    "before": {
      "id": "10fdbf67-c387-49b9-8b48-ee775454eff5",
      "slug": "kimchi-egg-tofu",
      "name": "韓式泡菜滑蛋豆腐",
      "description": "泡菜配滑蛋和豆腐，微辣開胃，口感柔滑。",
      "method": "braised",
      "meal_role": "protein_side",
      "is_complete_meal": false,
      "primary_protein": "tofu",
      "base_servings": 1,
      "total_time_minutes": 16,
      "diet": [
        "vegetarian",
        "egg_lacto",
        "low_calorie"
      ],
      "flavor": [
        "spicy",
        "sour",
        "salty"
      ],
      "steps": [
        {
          "text": "泡菜略切小塊，豆腐切件，雞蛋打散。",
          "step_no": 1
        },
        {
          "text": "小鍋加入少量油，中火炒泡菜 1 分鐘。",
          "step_no": 2
        },
        {
          "text": "加入豆腐和 2 湯匙水，煮 2 分鐘至豆腐熱透。",
          "step_no": 3
        },
        {
          "text": "加入生抽1茶匙拌勻。",
          "step_no": 4
        },
        {
          "text": "轉小火，倒入蛋液，輕輕推至半凝固。",
          "step_no": 5
        },
        {
          "text": "輕輕推至蛋液凝固熟透，即可上碟。",
          "step_no": 6
        }
      ],
      "ingredients": [
        {
          "id": "02032659-7807-436b-b74d-779e60929489",
