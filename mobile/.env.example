# PrepMeal mobile — public Expo configuration.
#
# Copy this file to `.env` and fill in the values. Everything here is PUBLIC
# (shipped inside the client bundle); never put a server secret, service-role
# key, OAuth client secret, or keystore password in this file.
#
# NOTE:
# - Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.

# --- Supabase (Project Settings -> API; ANON/public key only) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Native "Sign in with Google" (optional) ---
# All three are PUBLIC OAuth client identifiers, not secrets. The Google button
# stays hidden until the platform's values are present (see
# src/features/auth/social/googleAvailability.ts).
#
# Web client id — required on every platform (Android matches its own OAuth
# client by package name + SHA-1 at the console, so it needs only this):
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# iOS-only — the iOS OAuth client id and its reversed form (URL scheme). Setting
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME also wires the google-signin config plugin
# in app.config.js:
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-client-id
