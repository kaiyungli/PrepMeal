# PrepMeal mobile — public Supabase configuration.
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API). Only the ANON (public) key belongs here.
#
# NOTE:
# - Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# - These are public values, shipped inside the client bundle. Do NOT put the
#   service-role key or any server secret in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
